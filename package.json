{
  "name": "toolpath-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Examples for the Toolpath API and its TypeScript, Python and React packages",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings=0 && uvx --from ruff==0.16.2 ruff check python",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.6.2"
  },
  "pnpm": {
    "overrides": {
      "@toolpath/example-tool-matching>@toolpath/tool-matching": "link:../toolpath_services/public-packages/tool-matching",
      "@toolpath/example-tool-matching>@toolpath/tool-support": "link:../toolpath_services/public-packages/tool-support",
      "@toolpath/example-tool-matching>@toolpath/api": "link:../toolpath_services/public-packages/sdk-typescript"
    }
  }
}
